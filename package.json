{
  "name": "thingmaker",
  "private": true,
  "version": "0.0.0",
  "description": "ThingMaker: one desktop for Claude Code, Codex and Gemini on your own subscriptions (Tauri 2 / React / Rust supervisor).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter @thingmaker/desktop run tauri dev --config src-tauri/tauri.dev.conf.json",
    "rust:test": "cargo test --workspace --exclude thingmaker-desktop",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "app": "bash scripts/install-app.sh",
    "phone": "bash scripts/phone.sh"
  }
}
